# Пример для avtovozom.com: скопируйте на сервер (например /etc/caddy/Caddyfile) и подставьте свой email для ACME.
# Перед запуском: DNS A-записи @, www, api → IP сервера; порты 80/443 открыты; docker compose.prod.yml запущен.

{
	email noreply@avtovozom.com
}

# Канонический домен без www (SEO: один URL, без дублей).
# Опционально: отдавать /media и /media-img с того же origin, что и сайт
# (лучше HTTP-кэш браузера, проще CDN). Тогда в NEXT_PUBLIC_API_URL для img
# можно оставить api.*, либо проксировать медиа сюда и сменить mediaSrc на relative.
avtovozom.com {
	encode gzip
	# Раскомментируйте после проверки, что api слушает :8000 на этом хосте:
	# handle /media* {
	# 	reverse_proxy 127.0.0.1:8000
	# }
	reverse_proxy 127.0.0.1:3000
}

www.avtovozom.com {
	redir https://avtovozom.com{uri} permanent
}

api.avtovozom.com {
	encode gzip
	reverse_proxy 127.0.0.1:8000 {
		transport http {
			read_timeout 5m
			write_timeout 5m
		}
	}
}
